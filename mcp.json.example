{
  "mcpServers": {
    "alpaca-paper": {
      "command": "uvx",
      "args": ["--with", "fastmcp<4", "alpaca-mcp-server"],
      "env": {
        "ALPACA_API_KEY": "replace-with-paper-key",
        "ALPACA_SECRET_KEY": "replace-with-paper-secret",
        "ALPACA_PAPER_TRADE": "true",
        "ALPACA_TOOLSETS": "account,assets,stock-data,options-data"
      }
    }
  }
}
